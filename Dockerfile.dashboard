# ╔══════════════════════════════════════════════════════════════════╗
# ║  Streamlit dashboard image — the "dining room" of the restaurant ║
# ║  It never loads the model itself: it asks the API (http://api:8000)
# ║  Nunca carga el modelo: le pregunta a la API (http://api:8000)    ║
# ╚══════════════════════════════════════════════════════════════════╝
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 API_URL=http://api:8000
WORKDIR /app

COPY requirements-app.txt .
RUN pip install --no-cache-dir -r requirements-app.txt

COPY app/ app/
COPY src/__init__.py src/utils.py src/
COPY params.yaml ./

RUN useradd --create-home appuser
USER appuser

EXPOSE 8501
CMD ["streamlit", "run", "app/dashboard.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
